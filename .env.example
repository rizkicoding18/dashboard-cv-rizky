DATABASE_URL=file:data/app.db
TURSO_AUTH_TOKEN=

# Production file uploads. On Vercel, create and link a Blob store so images/PDFs
# can upload (serverless disk is read-only and request bodies cap at 4.5 MB).
# Locally, files stay in data/uploads unless this token is set.
BLOB_READ_WRITE_TOKEN=
BLOB_ACCESS=public

AUTH_USERNAME=admin
AUTH_PASSWORD=rizky
AUTH_SECRET=
